// =====================================================================//
//            Stokes‑Darcy_ShapeOpt_Example3_3D                          //
//                   Zhou, Li, Li, Zhu (2026)                           //
//                     H¹ gradient flow algorithm                       //
// Implements Example3 3D: porous-walled diffuser model.                //
// Stokes‑Darcy shape optimization to minimize free‑flow energy loss.   //
// =====================================================================//
load "iovtk";
string caption3="function3D";

load "gmsh"
load "medit"

mesh3 Th = gmshload3("diffusion.msh");
mesh3 Thf = trunc(Th, region == 1);
mesh3 Thp = trunc(Th, region == 2);

/* ==================== PHYSICAL PARAMETERS ==================== */
real mu = 1.0;
real kp = 0.01;
real gcoef = 1.0;
real coeffBJS = 1.0;

real tol=0.000001;

// Macro definitions
macro bilin1(u1,u2,u3,v1,v2,v3) (dx(u1)*dx(v1) + dy(u2)*dy(v2) + dz(u3)*dz(v3) +
    0.5*(dy(u1)+dx(u2))*(dy(v1)+dx(v2)) +
    0.5*(dz(u1)+dx(u3))*(dz(v1)+dx(v3)) +
    0.5*(dz(u2)+dy(u3))*(dz(v2)+dy(v3))) //EOM

macro bilin2(u1, u2, u3, v1, v2, v3) (
    dx(u1)*dx(v1) + dy(u1)*dy(v1) + dz(u1)*dz(v1) +
    dx(u2)*dx(v2) + dy(u2)*dy(v2) + dz(u2)*dz(v2) +
    dx(u3)*dx(v3) + dy(u3)*dy(v3) + dz(u3)*dz(v3)) //EOM

macro grad(p) [dx(p),dy(p),dz(p)] //EOM
macro div(u1,u2,u3) (dx(u1)+dy(u2)+dz(u3)) //EOM

macro Ptau(u1,u2,u3) [u1 - (u1*N.x + u2*N.y + u3*N.z)*N.x,
                       u2 - (u1*N.x + u2*N.y + u3*N.z)*N.y,
                       u3 - (u1*N.x + u2*N.y + u3*N.z)*N.z] //EOM

macro PtauDot(u1,u2,u3, v1,v2,v3) (
    u1*v1 + u2*v2 + u3*v3
  - (u1*N.x + u2*N.y + u3*N.z)*(v1*N.x + v2*N.y + v3*N.z)
) //EOM

macro Dn(f) (dx(f)*N.x + dy(f)*N.y + dz(f)*N.z) //EOM

// Boundary conditions and source terms
func u01 = 0;
func u02 = 1.0;
func u03 = 0;
func fx = 0;
func fy = 0;
func fz = 0;
func fp = 0;
func dxfx = 0;
func dyfx = 0;
func dzfx = 0;
func dxfy = 0;
func dyfy = 0;
func dzfy = 0;
func dxfz = 0;
func dyfz = 0;
func dzfz = 0;
func dxfp = 0;
func dyfp = 0;
func dzfp = 0;

// Finite element spaces
fespace Vh(Thf, P1b);
fespace Qh(Thf, P1);
fespace Wh(Thp, P1);
fespace Wpf(Th,P1);

// Variables for Stokes-Darcy system
Vh uf1, uf2, uf3, vf1, vf2, vf3;
Qh p, q;
Wh phi, psi;
Vh velocityMagnitude;

// Variables for adjoint system
Vh yf1,yf2,yf3,xf1,xf2,xf3;
Qh r,e;
Wh eta,xi;

// Variables for shape derivatives
Wpf d1,d2,d3,theta1,theta2,theta3;
Wpf kappa = 0.5;

// Optimization parameters
real Jnew = 1.0;
real Jold = 0.5;
real step = 0.0001;
real initialStep = step;
real temp;
int iter;
int maxIter = 400;

// Lagrange multiplier and volume constraint
real lagrange = 0.0;
real volume = int3d(Thf)(1.0);
real VolTarg = 1.5*int3d(Thf)(1.0);
real beta = 1000;
real beta1 = 1.0;

bool saveFirstStep = true;

// Quantitative data variables
real timeStart = clock();
real Jinit = 0.0;
real Jfinal = 0.0;
real Jreduction = 0.0;
real Ginit = 0.0;
real Gfinal = 0.0;
real Greduction = 0.0;
real VolInit = int3d(Thf)(1.0);
real VolFinal = 0.0;
real VolError = 0.0;
real VolErrorRel = 0.0;
real cpuTime = 0.0;
int Niter = 0;
int convFlag = 0;
int NeFluid = 0;
int NePorous = 0;
int NvFluid = 0;
int NvPorous = 0;
real gradNormFinal = 0.0;
real lastStep = step;

// ==================== Initial solve ====================
solve StokesDarcyInit(<[uf1],[uf2],[uf3],[p],[phi]>, <[vf1],[vf2],[vf3],[q],[psi]>)
    = int3d(Thf)(2*mu*(bilin1(uf1,uf2,uf3,vf1,vf2,vf3)))
    + int3d(Thp)(kp*gcoef*grad(phi)'*grad(psi))
    - int3d(Thf)(p*div(vf1,vf2,vf3))
    - int3d(Thf)(q*div(uf1,uf2,uf3))
    + int2d(Thf,7)(coeffBJS*(Ptau(uf1,uf2,uf3)'*Ptau(vf1,vf2,vf3)))
    + int2d(Thf,7)(gcoef*(phi*(vf1*N.x+vf2*N.y+vf3*N.z)))
    - int2d(Thf,7)(gcoef*((uf1*N.x+uf2*N.y+uf3*N.z)*psi))
    + int3d(Thf)(p*q*1e-8)
    - int3d(Thf)(fx*vf1 + fy*vf2 + fz*vf3)
    - int3d(Thp)(gcoef*fp*psi)
    + on(3,uf1=u01,uf2=u02,uf3=u03)
    + on(5,phi=0);

real pVolInit = int3d(Thf)(p) / int3d(Thf)(1.0);
p = p - pVolInit;
velocityMagnitude = sqrt(uf1^2 + uf2^2 + uf3^2);

Jinit = int3d(Thf)(2*mu*(bilin1(uf1,uf2,uf3,uf1,uf2,uf3)));
Ginit = Jinit + lagrange*(VolInit - VolTarg) + 0.5*beta*(VolInit - VolTarg)^2;

cout << "Initial Jinit = " << Jinit << endl;
cout << "Initial Ginit = " << Ginit << endl;

// ==================== Main optimization loop ====================
for(iter = 1; iter <= maxIter; iter++)
{
    cout << "Iteration " << iter << " ----" << endl;

    if(iter > 1) {
        temp = abs(Jnew - Jold) / abs(Jold);
        if(temp < tol && iter > 10) {
            convFlag = 1;
            Niter = iter;
            cout << "Converged after " << iter << " iterations" << endl;
            break;
        }
    }
    Jold = Jnew;

    solve StokesDarcy(<[uf1],[uf2],[uf3],[p],[phi]>, <[vf1],[vf2],[vf3],[q],[psi]>)
    = int3d(Thf)(2*mu*(bilin1(uf1,uf2,uf3,vf1,vf2,vf3)))
    + int3d(Thp)(kp*gcoef*grad(phi)'*grad(psi))
    - int3d(Thf)(p*div(vf1,vf2,vf3))
    - int3d(Thf)(q*div(uf1,uf2,uf3))
    + int2d(Thf,7)(coeffBJS*(Ptau(uf1,uf2,uf3)'*Ptau(vf1,vf2,vf3)))
    + int2d(Thf,7)(gcoef*(phi*(vf1*N.x+vf2*N.y+vf3*N.z)))
    - int2d(Thf,7)(gcoef*((uf1*N.x+uf2*N.y+uf3*N.z)*psi))
    + int3d(Thf)(p*q*1e-8)
    - int3d(Thf)(fx*vf1 + fy*vf2 + fz*vf3)
    - int3d(Thp)(gcoef*fp*psi)
    + on(3,uf1=u01,uf2=u02,uf3=u03)
    + on(5,phi=0);

    real pVol = int3d(Thf)(p) / int3d(Thf)(1.0);
    p = p - pVol;
    velocityMagnitude = sqrt(uf1^2 + uf2^2 + uf3^2);

    if (saveFirstStep || iter % 10 == 0) {
        string iterStr = iter;

        {
            ofstream file("uf_iter"+iterStr+".dat");
            file << "TITLE = \"Velocity Field\"" << endl;
            file << "VARIABLES = \"X\", \"Y\", \"Z\", \"U\", \"V\", \"W\", \"VelocityMagnitude\"" << endl;
            file << "ZONE T=\"Fluid Domain (Stokes Region)\", NODES=" << Thf.nv
                 << ", ELEMENTS=" << Thf.nt << ", DATAPACKING=POINT, ZONETYPE=FETETRAHEDRON" << endl;
            file << "# Physical Parameters: mu=" << mu << endl;
            for (int i = 0; i < Thf.nv; i++) {
                real xx = Thf(i).x;
                real yy = Thf(i).y;
                real zz = Thf(i).z;
                real uu = uf1(xx, yy, zz);
                real vv = uf2(xx, yy, zz);
                real ww = uf3(xx, yy, zz);
                real velMag = sqrt(uu^2 + vv^2 + ww^2);
                file << xx << " " << yy << " " << zz << " " << uu << " " << vv << " " << ww << " " << velMag << endl;
            }
            for (int i = 0; i < Thf.nt; i++) {
                file << Thf[i][0]+1 << " " << Thf[i][1]+1 << " " << Thf[i][2]+1 << " " << Thf[i][3]+1 << endl;
            }
        }

        {
            ofstream file("p_iter"+iterStr+".dat");
            file << "TITLE = \"Pressure Field\"" << endl;
            file << "VARIABLES = \"X\", \"Y\", \"Z\", \"Pressure\"" << endl;
            file << "ZONE T=\"Fluid Domain (Stokes Region)\", NODES=" << Thf.nv
                 << ", ELEMENTS=" << Thf.nt << ", DATAPACKING=POINT, ZONETYPE=FETETRAHEDRON" << endl;
            file << "# Physical Parameters: mu=" << mu << endl;
            for (int i = 0; i < Thf.nv; i++) {
                real xx = Thf(i).x;
                real yy = Thf(i).y;
                real zz = Thf(i).z;
                real pressure = p(xx, yy, zz);
                file << xx << " " << yy << " " << zz << " " << pressure << endl;
            }
            for (int i = 0; i < Thf.nt; i++) {
                file << Thf[i][0]+1 << " " << Thf[i][1]+1 << " " << Thf[i][2]+1 << " " << Thf[i][3]+1 << endl;
            }
        }

        {
            ofstream file("phi_iter"+iterStr+".dat");
            file << "TITLE = \"Darcy Pressure Field\"" << endl;
            file << "VARIABLES = \"X\", \"Y\", \"Z\", \"Phi\"" << endl;
            file << "ZONE T=\"Porous Domain (Darcy Region)\", NODES=" << Thp.nv
                 << ", ELEMENTS=" << Thp.nt << ", DATAPACKING=POINT, ZONETYPE=FETETRAHEDRON" << endl;
            file << "# Physical Parameters: kp=" << kp << endl;
            for (int i = 0; i < Thp.nv; i++) {
                real xx = Thp(i).x;
                real yy = Thp(i).y;
                real zz = Thp(i).z;
                real phival = phi(xx, yy, zz);
                file << xx << " " << yy << " " << zz << " " << phival << endl;
            }
            for (int i = 0; i < Thp.nt; i++) {
                file << Thp[i][0]+1 << " " << Thp[i][1]+1 << " " << Thp[i][2]+1 << " " << Thp[i][3]+1 << endl;
            }
        }

        if (saveFirstStep) {
            saveFirstStep = false;
        }
    }

    solve Adjoint(<[yf1],[yf2],[yf3],[r],[eta]>, <[xf1],[xf2],[xf3],[e],[xi]>)
    = int3d(Thf)(2*mu*(bilin1(yf1,yf2,yf3,xf1,xf2,xf3)))
    + int3d(Thp)(kp*gcoef*grad(eta)'*grad(xi))
    - int3d(Thf)(r*div(xf1,xf2,xf3))
    - int3d(Thf)(e*div(yf1,yf2,yf3))
    + int2d(Thf,7)(coeffBJS*(Ptau(yf1,yf2,yf3)'*Ptau(xf1,xf2,xf3)))
    - int2d(Thf,7)(gcoef*(eta*(xf1*N.x+xf2*N.y+xf3*N.z)))
    + int2d(Thf,7)(gcoef*((yf1*N.x+yf2*N.y+yf3*N.z)*xi))
    + int3d(Thf)(r*e*1e-8)
    - int3d(Thf)(4*mu*(bilin1(uf1,uf2,uf3,xf1,xf2,xf3)))
    + on(3,yf1=0,yf2=0,yf3=0) + on(5,eta=0);

    Jnew = int3d(Thf)(2*mu*(bilin1(uf1,uf2,uf3,uf1,uf2,uf3)))
         + lagrange*(volume - VolTarg)
         + 0.5*beta*(volume - VolTarg)^2;

    ofstream obj("objective.txt",append);
    obj << Jnew << endl;
    cout << "The value of the cost functional: " << Jnew << endl;

    volume = int3d(Thf)(1.0);
    real VolErr = VolTarg - volume;
    ofstream ve("volerr.txt",append);
    ve << VolErr << endl;
    cout << "Volume Error: " << VolErr << endl;

    lagrange = lagrange + beta1*(volume - VolTarg);
    cout << "lagrange: " << lagrange << endl;

    Vh PtauDotValue = PtauDot(uf1, uf2, uf3, yf1, yf2, yf3);
    Vh phiYdotN = phi*(yf1*N.x + yf2*N.y + yf3*N.z);
    Vh etaUdotN = eta*(uf1*N.x + uf2*N.y + uf3*N.z);

    solve H1Extension(<[d1],[d2],[d3]>,<[theta1],[theta2],[theta3]>)
    = int3d(Th)(bilin2(d1,d2,d3,theta1,theta2,theta3)+d1*theta1+d2*theta2+d3*theta3)
     + int2d(Thf,7)(((2*mu*bilin1(uf1, uf2, uf3, uf1, uf2, uf3))
     - (2*mu*bilin1(uf1, uf2, uf3,yf1, yf2, yf3))
     + (fx*yf1+fy*yf2+fz*yf3)
     - (kp*gcoef*grad(phi)'*grad(eta))
     + (gcoef*fp*eta)
     - (coeffBJS*(Dn(PtauDotValue) + kappa*PtauDotValue))
     - (gcoef*(Dn(phiYdotN) + kappa*phiYdotN))
     + (gcoef*(Dn(etaUdotN) + kappa*etaUdotN)))*(theta1*N.x+theta2*N.y+theta3*N.z))
     + int2d(Thf,7)((theta1*N.x+theta2*N.y+theta3*N.z)*(lagrange+beta*(volume - VolTarg)))
     + on(3,4,5,6,d1=0,d2=0,d3=0);

    real gradNorm = sqrt(int3d(Th)(d1^2 + d2^2 + d3^2));
    gradNormFinal = gradNorm;
    cout << "Gradient norm = " << gradNorm << endl;

    lastStep = step;
    Niter = iter;

    fespace Wh1P1(Thf, P1);
    fespace Wh2P1(Thp, P1);

    Wh1P1 d1fP1, d2fP1, d3fP1;
    Wh2P1 d1pP1, d2pP1, d3pP1;

    d1fP1 = d1;
    d2fP1 = d2;
    d3fP1 = d3;
    d1pP1 = d1;
    d2pP1 = d2;
    d3pP1 = d3;

    mesh3 Thfnew = movemesh(Thf, [x + step*d1fP1, y + step*d2fP1, z + step*d3fP1]);
    mesh3 Thpnew = movemesh(Thp, [x + step*d1pP1, y + step*d2pP1, z + step*d3pP1]);

    Th = Thfnew + Thpnew;
    Thf = Thfnew;
    Thp = Thpnew;

    plot([uf1,uf2,uf3], wait=0, cmm="Optimized Th mesh iteration: " + iter);
}

///// END OF THE OPTIMIZATION LOOP /////

// Final solve on optimized mesh
solve StokesDarcyFinal(<[uf1],[uf2],[uf3],[p],[phi]>, <[vf1],[vf2],[vf3],[q],[psi]>)
    = int3d(Thf)(2*mu*(bilin1(uf1,uf2,uf3,vf1,vf2,vf3)))
    + int3d(Thp)(kp*gcoef*grad(phi)'*grad(psi))
    - int3d(Thf)(p*div(vf1,vf2,vf3))
    - int3d(Thf)(q*div(uf1,uf2,uf3))
    + int2d(Thf,7)(coeffBJS*(Ptau(uf1,uf2,uf3)'*Ptau(vf1,vf2,vf3)))
    + int2d(Thf,7)(gcoef*(phi*(vf1*N.x+vf2*N.y+vf3*N.z)))
    - int2d(Thf,7)(gcoef*((uf1*N.x+uf2*N.y+uf3*N.z)*psi))
    + int3d(Thf)(p*q*1e-8)
    - int3d(Thf)(fx*vf1 + fy*vf2 + fz*vf3)
    - int3d(Thp)(gcoef*fp*psi)
    + on(3,uf1=u01,uf2=u02,uf3=u03)
    + on(5,phi=0);

real pVolFinal = int3d(Thf)(p) / int3d(Thf)(1.0);
p = p - pVolFinal;
velocityMagnitude = sqrt(uf1^2 + uf2^2 + uf3^2);

// Compute final quantitative data
VolFinal = int3d(Thf)(1.0);
VolError = VolTarg - VolFinal;
VolErrorRel = abs(VolError) / abs(VolTarg);

Jfinal = int3d(Thf)(2*mu*(bilin1(uf1,uf2,uf3,uf1,uf2,uf3)));
Gfinal = Jfinal + lagrange*(VolFinal - VolTarg) + 0.5*beta*(VolFinal - VolTarg)^2;

real epsRed = 1e-30;
Jreduction = (Jinit - Jfinal) / max(abs(Jinit), epsRed);
Greduction = (Ginit - Gfinal) / max(abs(Ginit), epsRed);

NeFluid = Thf.nt;
NePorous = Thp.nt;
NvFluid = Thf.nv;
NvPorous = Thp.nv;
cpuTime = clock() - timeStart;

// Save final velocity field data
{
    ofstream file(caption3 + "_uf.dat");
    file << "TITLE = \"Velocity Field\"" << endl;
    file << "VARIABLES = \"X\", \"Y\", \"Z\", \"U\", \"V\", \"W\", \"VelocityMagnitude\"" << endl;
    file << "ZONE T=\"Fluid Domain (Stokes Region)\", NODES=" << Thf.nv
         << ", ELEMENTS=" << Thf.nt << ", DATAPACKING=POINT, ZONETYPE=FETETRAHEDRON" << endl;
    file << "# Physical Parameters: mu=" << mu << endl;

    for (int i = 0; i < Thf.nv; i++) {
        real xx = Thf(i).x;
        real yy = Thf(i).y;
        real zz = Thf(i).z;
        real uu = uf1(xx, yy, zz);
        real vv = uf2(xx, yy, zz);
        real ww = uf3(xx, yy, zz);
        real velMag = sqrt(uu^2 + vv^2 + ww^2);
        file << xx << " " << yy << " " << zz << " " << uu << " " << vv << " " << ww << " " << velMag << endl;
    }

    for (int i = 0; i < Thf.nt; i++) {
        file << Thf[i][0]+1 << " " << Thf[i][1]+1 << " " << Thf[i][2]+1 << " " << Thf[i][3]+1 << endl;
    }
}

// Save final pressure field data
{
    ofstream file(caption3 + "_p.dat");
    file << "TITLE = \"Pressure Field\"" << endl;
    file << "VARIABLES = \"X\", \"Y\", \"Z\", \"Pressure\"" << endl;
    file << "ZONE T=\"Fluid Domain (Stokes Region)\", NODES=" << Thf.nv
         << ", ELEMENTS=" << Thf.nt << ", DATAPACKING=POINT, ZONETYPE=FETETRAHEDRON" << endl;
    file << "# Physical Parameters: mu=" << mu << endl;

    for (int i = 0; i < Thf.nv; i++) {
        real xx = Thf(i).x;
        real yy = Thf(i).y;
        real zz = Thf(i).z;
        real pressure = p(xx, yy, zz);
        file << xx << " " << yy << " " << zz << " " << pressure << endl;
    }

    for (int i = 0; i < Thf.nt; i++) {
        file << Thf[i][0]+1 << " " << Thf[i][1]+1 << " " << Thf[i][2]+1 << " " << Thf[i][3]+1 << endl;
    }
}

// Save final Darcy pressure field data
{
    ofstream file(caption3 + "_phi.dat");
    file << "TITLE = \"Darcy Pressure Field\"" << endl;
    file << "VARIABLES = \"X\", \"Y\", \"Z\", \"Phi\"" << endl;
    file << "ZONE T=\"Porous Domain (Darcy Region)\", NODES=" << Thp.nv
         << ", ELEMENTS=" << Thp.nt << ", DATAPACKING=POINT, ZONETYPE=FETETRAHEDRON" << endl;
    file << "# Physical Parameters: kp=" << kp << endl;

    for (int i = 0; i < Thp.nv; i++) {
        real xx = Thp(i).x;
        real yy = Thp(i).y;
        real zz = Thp(i).z;
        real phival = phi(xx, yy, zz);
        file << xx << " " << yy << " " << zz << " " << phival << endl;
    }

    for (int i = 0; i < Thp.nt; i++) {
        file << Thp[i][0]+1 << " " << Thp[i][1]+1 << " " << Thp[i][2]+1 << " " << Thp[i][3]+1 << endl;
    }
}

savevtk("finalmesh.vtu", Th, dataname="FinalMesh");
string outputFile1 = caption3 + "_Solution.vtu";
savevtk(outputFile1, Th, [uf1, uf2, uf3], p, phi, dataname="Velocity Pressure Potential");

// ============================================================
// Write quantitative data to file
// ============================================================
ofstream qout("quantitative.txt");

qout << "Quantitative results" << endl;
qout << endl;
qout << "case" << endl;
qout << caption3 << endl;
qout << endl;

qout << "physical parameters" << endl;
qout << "mu " << mu << endl;
qout << "kp " << kp << endl;
qout << "gcoef " << gcoef << endl;
qout << "coeffBJS " << coeffBJS << endl;
qout << endl;

qout << "algorithmic parameters" << endl;
qout << "tol " << tol << endl;
qout << "maxIter " << maxIter << endl;
qout << "beta " << beta << endl;
qout << "beta1 " << beta1 << endl;
qout << "initialStep " << initialStep << endl;
qout << "lastStep " << lastStep << endl;
qout << "convFlag " << convFlag << endl;
qout << endl;

qout << "volume data" << endl;
qout << "VolInit " << VolInit << endl;
qout << "VolTarg " << VolTarg << endl;
qout << "VolFinal " << VolFinal << endl;
qout << "VolError " << VolError << endl;
qout << "VolErrorRel " << VolErrorRel << endl;
qout << endl;

qout << "optimization results" << endl;
qout << "Jinit " << Jinit << endl;
qout << "Jfinal " << Jfinal << endl;
qout << "Jreduction " << Jreduction << endl;
qout << "Ginit " << Ginit << endl;
qout << "Gfinal " << Gfinal << endl;
qout << "Greduction " << Greduction << endl;
qout << "Niter " << Niter << endl;
qout << "NeFluid " << NeFluid << endl;
qout << "NePorous " << NePorous << endl;
qout << "NvFluid " << NvFluid << endl;
qout << "NvPorous " << NvPorous << endl;
qout << "cpuTime " << cpuTime << endl;
qout << "gradNormFinal " << gradNormFinal << endl;
qout << endl;

qout << "latex row: optimization" << endl;
qout << caption3 << " & "
      << Jinit << " & "
      << Jfinal << " & "
      << Jreduction << " & "
      << Ginit << " & "
      << Gfinal << " & "
      << Greduction << " & "
      << VolErrorRel << " & "
      << Niter << " & "
      << "(" << NeFluid << "," << NePorous << ")" << " & "
      << "(" << NvFluid << "," << NvPorous << ")" << " & "
      << cpuTime << " \\\\" << endl;
qout << endl;

cout << endl;
cout << "========================================" << endl;
cout << "QUANTITATIVE RESULTS" << endl;
cout << "========================================" << endl;
cout << "Jinit (raw dissipation)    = " << Jinit << endl;
cout << "Jfinal (raw dissipation)   = " << Jfinal << endl;
cout << "Jreduction                 = " << Jreduction << endl;
cout << "Ginit (augmented Lagr.)    = " << Ginit << endl;
