cout << "Gfinal augmented Lagrangian = " << Gfinal << endl;
cout << "Greduction                  = " << Greduction << endl;
cout << "VolInit                     = " << VolInit << endl;
cout << "VolTarg                     = " << VolTarg << endl;
cout << "VolFinal                    = " << VolFinal << endl;
cout << "VolError                    = " << VolError << endl;
cout << "VolErrorRel                 = " << VolErrorRel << endl;
cout << "Niter                       = " << Niter << endl;
cout << "convFlag                    = " << convFlag << endl;
